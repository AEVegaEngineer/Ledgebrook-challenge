  "item": [
    {
      "name": "Decision outcomes",
      "item": [
        {
          "name": "Approve - ideal application",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test(\"Decision is APPROVE\", function () {",
                  "  pm.expect(response.decision).to.eql(\"APPROVE\");",
                  "});",
                  "pm.test(\"Approved amount and metrics are correct\", function () {",
                  "  pm.expect(response.approvedAmount).to.eql(280000);",
                  "  pm.expect(response.metrics).to.deep.eql({ debtToIncome: 0.25, loanToValue: 0.7 });",
                  "  pm.expect(response.reasons).to.deep.eql([]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annualIncome\": 120000,\n  \"monthlyDebt\": 2500,\n  \"propertyValue\": 400000,\n  \"requestedLoan\": 280000,\n  \"creditScore\": 720\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/underwriting/decision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "underwriting", "decision"]
            },
            "description": "An ideal application should be approved with no reasons."
          },
          "response": []
        },
        {
          "name": "Refer - credit score requires review",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test(\"Decision is REFER with the expected reason\", function () {",
                  "  pm.expect(response.decision).to.eql(\"REFER\");",
                  "  pm.expect(response).not.to.have.property(\"approvedAmount\");",
                  "  pm.expect(response.reasons.map((reason) => reason.code)).to.deep.eql([\"CREDIT_SCORE_REFER\"]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annualIncome\": 120000,\n  \"monthlyDebt\": 2500,\n  \"propertyValue\": 400000,\n  \"requestedLoan\": 280000,\n  \"creditScore\": 650\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/underwriting/decision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "underwriting", "decision"]
            },
            "description": "A credit score below 680 but not below 600 should be referred."
          },
          "response": []
        },
        {
          "name": "Decline - mixed non-ideal factors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test(\"Decision is DECLINE and all factors are explained\", function () {",
                  "  pm.expect(response.decision).to.eql(\"DECLINE\");",
                  "  pm.expect(response).not.to.have.property(\"approvedAmount\");",
                  "  pm.expect(response.reasons.map((reason) => reason.code)).to.deep.eql([",
                  "    \"CREDIT_SCORE_DECLINE\",",
                  "    \"DEBT_TO_INCOME_REFER\",",
                  "    \"LOAN_TO_VALUE_REFER\"",
                  "  ]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"annualIncome\": 120000,\n  \"monthlyDebt\": 4500,\n  \"propertyValue\": 400000,\n  \"requestedLoan\": 340000,\n  \"creditScore\": 590\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/underwriting/decision",
              "host": ["{{baseUrl}}"],
              "path": ["api", "underwriting", "decision"]
            },
            "description": "A decline-level credit score takes precedence while referral-level DTI and LTV reasons remain visible."
          },
          "response": []
        }
